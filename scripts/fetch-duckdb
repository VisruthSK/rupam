#!/usr/bin/env bash
set -euo pipefail

version=2.0.1
root=$(cd "$(dirname "$0")/.." && pwd)
destination="$root/vendor/duckdb"

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) platform=linux-amd64 sha=2d5655fd5948dfb0cd16df5fc8f7cdf0b37948374cf0629af995cf4a5e3a4c82 ;;
  Linux-aarch64) platform=linux-arm64 sha=3d581ff935f1836363cc459e640737cdc1892ab3ed69e74853e93f01d9d071f0 ;;
  Darwin-x86_64) platform=osx-amd64 sha=c4458122a44182f8e790d2b1e731139d7f8437ce0b14fe5a0e461612979db76b ;;
  Darwin-arm64) platform=osx-arm64 sha=adaada35202db67d010b06277320aa700f1313d9997b549a948349c9fd749a41 ;;
  MINGW*-x86_64 | MSYS*-x86_64 | CYGWIN*-x86_64) platform=windows-mingw sha=99a432db9e0edca8ddde279747f3dbd56605492f5a5d7eca879525a4c68f772c ;;
  *) echo "No DuckDB $version static build for $(uname -s) $(uname -m)" >&2; exit 1 ;;
esac

archive=$(mktemp)
trap 'rm -f "$archive"' EXIT
curl -fsSL -o "$archive" \
  "https://github.com/duckdb/duckdb/releases/download/v$version/duckdb-static-libs-$platform.tar.gz"

if command -v sha256sum >/dev/null; then
  actual=$(sha256sum "$archive" | cut -d' ' -f1)
else
  actual=$(shasum -a 256 "$archive" | cut -d' ' -f1)
fi
if [ "$actual" != "$sha" ]; then
  echo "Checksum mismatch for duckdb-static-libs-$platform.tar.gz" >&2
  exit 1
fi

mkdir -p "$destination"
tar xzf "$archive" -C "$destination"
curl -fsSL -o "$destination/LICENSE" "https://raw.githubusercontent.com/duckdb/duckdb/v$version/LICENSE"
echo "DuckDB $version ($platform) in vendor/duckdb"
