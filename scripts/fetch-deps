#!/usr/bin/env bash
set -euo pipefail

duckdb=2.0.1
nanoarrow=0.9.0
nanoarrow_sha=22c3edeaa5cb384c6da091f32a4e1c937779f2d62f84d646028de658b03d4385

root=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

fetch() {
  curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 -o "$2" "$1"
  local actual
  if command -v sha256sum >/dev/null; then
    actual=$(sha256sum "$2" | cut -d' ' -f1)
  else
    actual=$(shasum -a 256 "$2" | cut -d' ' -f1)
  fi
  if [ "$actual" != "$3" ]; then
    echo "Checksum mismatch for $1" >&2
    exit 1
  fi
}

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) platform=linux-amd64 sha=2d5655fd5948dfb0cd16df5fc8f7cdf0b37948374cf0629af995cf4a5e3a4c82 ;;
  Linux-aarch64) platform=linux-arm64 sha=3d581ff935f1836363cc459e640737cdc1892ab3ed69e74853e93f01d9d071f0 ;;
  Darwin-x86_64) platform=osx-amd64 sha=c4458122a44182f8e790d2b1e731139d7f8437ce0b14fe5a0e461612979db76b ;;
  Darwin-arm64) platform=osx-arm64 sha=adaada35202db67d010b06277320aa700f1313d9997b549a948349c9fd749a41 ;;
  MINGW*-x86_64 | MSYS*-x86_64 | CYGWIN*-x86_64) platform=windows-mingw sha=99a432db9e0edca8ddde279747f3dbd56605492f5a5d7eca879525a4c68f772c ;;
  *) echo "No DuckDB $duckdb static build for $(uname -s) $(uname -m)" >&2; exit 1 ;;
esac

fetch "https://github.com/duckdb/duckdb/releases/download/v$duckdb/duckdb-static-libs-$platform.tar.gz" \
  "$work/duckdb.tar.gz" "$sha"
find "$root/vendor/duckdb" -mindepth 1 ! -name dune -delete
tar xzf "$work/duckdb.tar.gz" -C "$root/vendor/duckdb" \
  duckdb.h duckdb_static_extension.h \
  libduckdb_static.a libparquet_extension.a libjson_extension.a libcore_functions_extension.a
curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
  -o "$root/vendor/duckdb/LICENSE" "https://raw.githubusercontent.com/duckdb/duckdb/v$duckdb/LICENSE"

fetch "https://github.com/apache/arrow-nanoarrow/archive/refs/tags/apache-arrow-nanoarrow-$nanoarrow.tar.gz" \
  "$work/nanoarrow.tar.gz" "$nanoarrow_sha"
prefix="arrow-nanoarrow-apache-arrow-nanoarrow-$nanoarrow"
tar xzf "$work/nanoarrow.tar.gz" -C "$work" \
  "$prefix/LICENSE.txt" "$prefix/NOTICE.txt" "$prefix/src/nanoarrow" "$prefix/thirdparty/flatcc"
source="$work/$prefix"
src="$source/src/nanoarrow"
flatcc="$source/thirdparty/flatcc"
out="$root/vendor/nanoarrow"
find "$out" -mindepth 1 -maxdepth 1 ! -name dune -exec rm -rf {} +
mkdir -p "$out/include/nanoarrow/common" "$out/include/nanoarrow/ipc" "$out/flatcc"
cp "$source/LICENSE.txt" "$source/NOTICE.txt" "$out/"
cp "$src/nanoarrow.h" "$src/nanoarrow_ipc.h" "$out/include/nanoarrow/"
cp "$src"/common/inline_*.h "$out/include/nanoarrow/common/"
cp "$src/ipc/flatcc_generated.h" "$out/include/nanoarrow/ipc/"
cp "$src"/common/{array,array_stream,schema,utils}.c "$src"/ipc/{decoder,reader,codecs,encoder,writer}.c "$out/"
cp "$flatcc"/src/runtime/{builder,emitter,refmap,verifier}.c "$out/"
cp -r "$flatcc/include" "$flatcc/LICENSE" "$out/flatcc/"
IFS=. read -r major minor patch <<< "$nanoarrow"
cat > "$out/include/nanoarrow/nanoarrow_config.h" <<EOF
#ifndef NANOARROW_CONFIG_H_INCLUDED
#define NANOARROW_CONFIG_H_INCLUDED
#define NANOARROW_VERSION_MAJOR $major
#define NANOARROW_VERSION_MINOR $minor
#define NANOARROW_VERSION_PATCH $patch
#define NANOARROW_VERSION "$nanoarrow"
#define NANOARROW_VERSION_INT (NANOARROW_VERSION_MAJOR * 10000 + NANOARROW_VERSION_MINOR * 100 + NANOARROW_VERSION_PATCH)
#define NANOARROW_NAMESPACE RupamNanoarrow
#endif
EOF

echo "DuckDB $duckdb ($platform) and nanoarrow $nanoarrow in vendor/"
