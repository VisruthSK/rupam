# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A typed language for interactive data analysis"
maintainer: ["Visruth Srimath Kandali <public@visruth.com>"]
authors: ["Visruth Srimath Kandali <public@visruth.com>"]
license: "GPL-3.0-or-later"
homepage: "https://github.com/VisruthSK/rupam"
bug-reports: "https://github.com/VisruthSK/rupam/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.5"}
  "menhir" {>= "20180523"}
  "yojson"
  "ppx_yojson_conv"
  "ppx_enumerate"
  "astring"
  "re"
  "digestif"
  "uucp"
  "toml"
  "ppx_expect" {with-test}
  "cmdliner" {>= "2.0"}
  "mosaic"
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/VisruthSK/rupam.git"
