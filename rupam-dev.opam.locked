opam-version: "2.0"
name: "rupam-dev"
version: "dev"
synopsis: "Internal tools for developing Rupam"
maintainer: "Visruth Srimath Kandali <public@visruth.com>"
authors: "Visruth Srimath Kandali <public@visruth.com>"
license: "GPL-3.0-or-later"
homepage: "https://github.com/VisruthSK/rupam"
bug-reports: "https://github.com/VisruthSK/rupam/issues"
depends: [
  "conf-mingw-w64-g++-x86_64" {os = "win32"}
  "astring" {= "0.8.5"}
  "base" {= "v0.17.3"}
  "cmarkit" {= "0.4.0"}
  "cmdliner" {= "2.1.2"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2"}
  "dune" {= "3.25.0"}
  "dune-configurator" {= "3.25.0"}
  "ISO8601" {= "0.2.6"}
  "lwt" {= "6.1.3"}
  "matrix" {= "0.3.0"}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "mosaic" {= "0.3.0"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml_intrinsics_kernel" {= "v0.17.3"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.9~preview"}
  "ocplib-endian" {= "1.2"}
  "octavius" {= "1.2.2"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_devtools-optcomp" {= "0.1"}
  "ppx_enumerate" {= "v0.17.0"}
  "ppx_js_style" {= "v0.17.1"}
  "ppx_sexp_conv" {= "v0.17.1"}
  "ppx_yojson_conv" {= "v0.17.1"}
  "ppx_yojson_conv_lib" {= "v0.17.0"}
  "ppxlib" {= "0.39.0"}
  "ppxlib_jane" {= "v0.17.4"}
  "ptime" {= "1.2.0"}
  "re" {= "1.14.0"}
  "rupam" {= "dev"}
  "sexplib0" {= "v0.17.0"}
  "toffee" {= "0.3.0"}
  "toml" {= "7.1.0"}
  "topkg" {= "1.1.1"}
  "uucp" {= "18.0.0"}
  "yojson" {= "3.0.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/VisruthSK/rupam.git"