(ocamllex lexer)

(menhir
 (modules parser))

(library
 (name rupam)
 (libraries ptime yojson uucp astring re sexplib0)
 (preprocess
  (pps ppx_enumerate ppx_yojson_conv ppx_sexp_conv)))

(rule
 (target adapters.ml)
 (deps
  runtime/display.R
  runtime/r.R
  runtime/dplyr.R
  runtime/python.py
  runtime/polars.py)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let r = {rupam|")
    (cat runtime/display.R)
    (cat runtime/r.R)
    (echo "|rupam}\n\nlet dplyr = {rupam|")
    (cat runtime/dplyr.R)
    (echo "|rupam}\n\nlet python = {rupam|")
    (cat runtime/python.py)
    (echo "|rupam}\n\nlet polars = {rupam|")
    (cat runtime/polars.py)
    (echo "|rupam}\n")))))

(rule
 (target build_id.ml)
 (action
  (with-stdout-to
   %{target}
   (echo "let revision = \"%{env:RUPAM_REVISION=}\"\n"))))
