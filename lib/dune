(ocamllex lexer)

(menhir
 (modules parser))

(library
 (name rupam)
 (libraries unix yojson uucp toml astring digestif re sexplib0 duckdb_static)
 (preprocess
  (pps ppx_enumerate ppx_yojson_conv ppx_sexp_conv))
 (foreign_stubs
  (language c)
  (names duckdb_stubs)
  (include_dirs ../vendor/duckdb)))

(rule
 (target adapters.ml)
 (deps
  runtime/numbers.R
  runtime/display.R
  runtime/r.R
  runtime/dplyr.R
  runtime/python.py
  runtime/polars.py)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let r = {rupam|")
    (cat runtime/numbers.R)
    (cat runtime/display.R)
    (cat runtime/r.R)
    (echo "|rupam}\n\nlet dplyr = {rupam|")
    (cat runtime/dplyr.R)
    (echo "|rupam}\n\nlet python = {rupam|")
    (cat runtime/python.py)
    (echo "|rupam}\n\nlet polars = {rupam|")
    (cat runtime/polars.py)
    (echo "|rupam}\n")))))
