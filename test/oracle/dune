(executable
 (name ipc_differential)
 (modules ipc_differential)
 (libraries yojson rupam_native))

(rule
 (alias integration)
 (deps ipc_fixtures.py)
 (action
  (progn
   (run python ipc_fixtures.py ipc)
   (run %{exe:ipc_differential.exe} ipc))))

