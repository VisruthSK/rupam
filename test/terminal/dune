(executable
 (name frames)
 (modules frames)
 (libraries matrix matrix.test astring unix))

(executable
 (name terminal_test)
 (modules terminal_test)
 (libraries
  rupam
  rupam_native
  rupam_console
  matrix
  matrix.test
  mosaic
  mosaic.test
  astring
  unix
  threads.posix))

(rule
 (alias integration)
 (deps
  %{bin:rupam}
  (source_tree ../../examples))
 (action
  (setenv
   RUPAM_TEST_BIN
   %{exe:../../bin/rupam_cli.exe}
   (setenv
    RUPAM_DEV_TEST_BIN
    %{exe:../../dev/rupam_dev.exe}
    (setenv
     RUPAM_EXAMPLES
     ../../examples
     (run %{exe:terminal_test.exe}))))))
