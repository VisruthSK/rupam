use contract "data-dict.yaml" as shop

let orders = load(shop.orders)
let margins = orders
  |> mutate(margin = revenue - coalesce(cost, 0.0))
  |> mutate(regional_mean = mean(margin), by = region)
  |> mutate(deviation = margin - regional_mean)

let measurements = margins
  |> select(customer_id, region, margin, deviation)
  |> pivot_longer(cols = (margin, deviation), names_to = measure, values_to = amount)
  |> arrange(region, customer_id, measure)

save_parquet(measurements, "regional-variation.parquet")
