# Data: datasets::penguins, exported from R 4.6.2 (344 observations).
let penguins = read_csv("penguins.csv")

let standardize(x) = (x - mean(x)) / sd(x)

let measured = penguins
  |> filter(some(body_mass) and some(bill_len))
  |> mutate(
       mass_kg = body_mass / 1000.0,
       bill_ratio = bill_len / bill_dep,
       size = match body_mass {
         ..<3500 => "small",
         3500=..<4500 => "medium",
         _ => "large",
       },
       mass_z = standardize(body_mass),
       by = species
     )

let by_species = measured
  |> summarize(
       n = n(),
       mean_mass = mean(mass_kg),
       sd_mass = sd(mass_kg),
       median_bill = median(bill_len),
       islands = n_distinct(island, missing = skip),
       by = species
     )
  |> arrange(desc(mean_mass))

print(by_species)

let heavy = measured
  |> filter(mass_z > 1.0, missing = skip)
  |> select(species, island, sex, mass_kg, mass_z)
  |> arrange(species, desc(mass_kg))

print(heavy)
write_parquet(by_species, "penguins-by-species.parquet")

let species = read_csv("species.csv")

let described = by_species
  |> left_join(species, by = species, relationship = many_to_one)
  |> select(species, habitat, n, mean_mass)

print(described)

let long = measured
  |> mutate(group_size = n(), by = species)
  |> select(species, island, bill_len, bill_dep)
  |> pivot_longer(cols = [bill_len, bill_dep], names_to = measure, values_to = mm)
  |> filter(island == "Biscoe")
  |> arrange(species, island, measure, mm)

print(long)
