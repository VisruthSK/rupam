let penguins = read_csv("penguins.csv")
# 344 rows × 8 columns
#   species      String
#   island       String
#   bill_len     Float?
#   bill_dep     Float?
#   flipper_len  Int?
#   body_mass    Int?
#   sex          String?
#   year         Int

# rupam doesn't have any concept of NA, or NaN, or Null
# Float? means values are either Floats, or None

# this will error since body_mass has missing values:
# penguins
#     |> summarize(
#         mass = mean(body_mass),
#         by = species
#     )
# 1:30  missing-policy-required
#  mean reads a column that can be missing. Say what to do with missing values: missing = skip ignores them, missing keep makes the result missing, missing = error stops the run

penguins
    |> summarize(
        mass = mean(body_mass),
        by = species,
        missing = skip
    )
# 3 rows × 2 columns, unordered
#    species        mass
#    <String>   <Float?>
# 1  Adelie      3700.66
# 2  Gentoo      5076.02
# 3  Chinstrap   3733.09

let year = 2007

# penguins
#     |> filter(year > 2007)
# will error since there are two things "year" could mean: the column, or the variable
# could change this later, but for now leaning towards explicit over inferring that

penguins
    |> filter($year > ^year) # $column; ^binding

# look ma, no tidy eval!
let profile(data, x, g) =
    data
        |> summarize(
            n = n(),
            average = mean(x),
            spread = sd(x),
            by = g,
            missing = skip
        )

# this just works!!!
penguins
    |> profile(bill_len / bill_dep, island)
# 3 rows × 4 columns, unordered
#    island         n   average    spread
#    <String>   <Int>  <Float?>  <Float?>
# 1  Torgersen     52      2.12      0.19
# 2  Biscoe       168      2.90      0.49
# 3  Dream        124      2.41      0.30

let trips = read_parquet("trips.parquet")
trips
    |> profile(fare, city)
#    city           n   average    spread
#    <String>   <Int>  <Float?>  <Float?>
# 1  Lisbon    500000     19.98     11.55
# 2  Osaka     500000     19.99     11.55
# 3  Lima      500000     20.00     11.55
# 4  Oslo      500000     20.01     11.55

